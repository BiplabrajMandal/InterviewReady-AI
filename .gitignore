# ==========================================
# InterviewReady AI — Root .gitignore
# ==========================================

# --- Dependencies ---
node_modules/
*/node_modules/
.pnp
.pnp.js

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
*.env
Backend/.env
Frontend/.env

# --- Production & Build Outputs ---
dist/
dist-ssr/
build/
out/
Frontend/dist/

# --- Logs & Debug ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Runtime & Storage ---
*.local
uploads/
temp/
tmp/
*.tmp

# --- IDE & Editor Specific ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
